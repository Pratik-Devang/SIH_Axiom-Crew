<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="@dimen/space_sm">

    <!-- Place icon -->
    <TextView
        android:id="@+id/tvResultIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="📍"
        android:textSize="24sp"
        android:gravity="center"
        android:background="@drawable/card_bg"
        android:layout_marginEnd="@dimen/space_md" />

    <!-- Name + address -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place Name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvResultAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_sm"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/space_xs" />

    </LinearLayout>

    <!-- Distance chip -->
    <TextView
        android:id="@+id/tvResultDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="@color/percorsa_primary"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold"
        android:background="@drawable/pill_gnss_fair"
        android:paddingStart="@dimen/chip_padding_horizontal"
        android:paddingEnd="@dimen/chip_padding_horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginStart="@dimen/space_sm" />

</LinearLayout>
