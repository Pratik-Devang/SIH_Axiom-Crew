<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090C10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#10141A"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnDebugBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="&#8592;"
            android:textSize="22sp"
            android:textColor="#94A3B8"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer Mode"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engineering Telemetry"
                android:textColor="#475569"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDebugRecIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9679; IDLE"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A2236" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PIPELINE -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIPELINE" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" android:layout_marginTop="2dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvDbgPipelineDiagram" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RAW SENSORS (200Hz) &#8594; VEHICLE FRAME &#8594; 10Hz CANONICAL &#8594; TCN BUFFER&#10;RAW GNSS &#8594; 1D ADAPTIVE KF &#8594; FILTERED GNSS &#8594; NAV STATE" android:textColor="#22C55E" android:textSize="10sp" android:fontFamily="monospace" android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <!-- SUBSYSTEM HEALTH -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SUBSYSTEM HEALTH" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvDbgHealthSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMU Stream: ACTIVE (200 Hz)  &#183;  GNSS Fix: ACTIVE" android:textColor="#22C55E" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tvDbgHealthDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accel &#183; Gyro &#183; RotVec &#183; Gravity &#183; Mag &#183; GNSS -- all ACTIVE" android:textColor="#64748B" android:textSize="11sp" />
            </LinearLayout>

            <!-- SENSOR TIMING -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SENSOR TIMING" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="IMU Rate" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgImuHz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="197.8 Hz (req 200 Hz)" android:textColor="#22C55E" android:textSize="11sp" android:textStyle="bold" android:fontFamily="monospace" />
                </LinearLayout>
                <TextView android:id="@+id/tvDbgTimingStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="dt avg 5.06 ms  &#183;  min 4.81  &#183;  max 5.32  &#183;  jitter 0.25 ms" android:textColor="#94A3B8" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- RAW SENSORS -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RAW SENSORS" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Accel" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgAccel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="X +0.000  Y +0.000  Z -9.810 m/s&#178;" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Gyro" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgGyro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="X +0.000  Y +0.000  Z +0.000 rad/s" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Quat" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgQuat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W 1.000  X 0.000  Y 0.000  Z 0.000" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Mag" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgMag" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="X +0.0  Y +0.0  Z +0.0 uT" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <TextView android:id="@+id/tvDbgRotationMatrix" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:fontFamily="monospace" android:visibility="gone" />
                <TextView android:id="@+id/tvDbgCalibrationMatrix" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:fontFamily="monospace" android:visibility="gone" />
            </LinearLayout>

            <!-- PROCESSED SENSORS -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROCESSED SENSORS" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Gravity" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgGravity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="X +0.00  Y +0.00  Z -9.81 m/s&#178;" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Linear Acc" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgLinearAccel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="X +0.00  Y +0.00  Z +0.00 m/s&#178;" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Veh Accel" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgVehicleFrameAccel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fwd +0.000  Left +0.000  Up -9.810 m/s&#178;" android:textColor="#94A3B8" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Veh Gyro" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgVehicleFrameGyro" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fwd +0.000  Left +0.000  Up +0.000 rad/s" android:textColor="#94A3B8" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Filter" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgFilterStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Deadband + Tremor  &#183;  ACTIVE" android:textColor="#22C55E" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="72dp" android:layout_height="wrap_content" android:text="Orientation" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgOrient" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="P +0&#176;  R +0&#176;  Y +0&#176;" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- GNSS -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GNSS" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvDbgGpsStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9679; GPS GOOD" android:textColor="#22C55E" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="2dp" />
                <TextView android:id="@+id/tvDbgGpsQualityReason" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Acc 4.8 m  &#183;  Fix age 210 ms  &#183;  Provider GPS" android:textColor="#64748B" android:textSize="10sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Coords" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgGpsCoords" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Raw 19.07600, 72.87770  &#183;  KF 19.07602, 72.87771" android:textColor="#E2E8F0" android:textSize="10sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="56dp" android:layout_height="wrap_content" android:text="Acc" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgGpsAccuracy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5 m" android:textColor="#94A3B8" android:textSize="11sp" android:fontFamily="monospace" />
                    <TextView android:id="@+id/tvDbgGpsSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 km/h" android:textColor="#94A3B8" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- TCN / 10 HZ STREAM -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TCN / 10 Hz STREAM" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <TextView android:id="@+id/tvDbgTcnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TCN Buffer: 50/50  READY" android:textColor="#22C55E" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/tvDbgTcnModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model: WARMING UP -- collecting 5-second IMU window" android:textColor="#64748B" android:textSize="10sp" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/tvDbgProcessedStream" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10Hz: ax+0.00 ay+0.00 az-9.81  gx+0.00 gy+0.00 gz+0.00" android:textColor="#475569" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- NAVIGATION ENGINE -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NAVIGATION ENGINE" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="Nav Mode" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgNavMode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="IDLE" android:textColor="#E2E8F0" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="Estimator" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgDrProvider" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PERCORSA_ESKF" android:textColor="#F59E0B" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="GNSS Filter" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgGnssQuality" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1D Adaptive KF  &#183;  ESKF ACTIVE  &#183;  TCN WARMING" android:textColor="#94A3B8" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="88dp" android:layout_height="wrap_content" android:text="Pos Accuracy" android:textColor="#64748B" android:textSize="11sp" />
                    <TextView android:id="@+id/tvDbgAccuracy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-- m  &#183;  RAW GNSS / KF GNSS" android:textColor="#94A3B8" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <TextView android:id="@+id/tvDbgInsTelemetry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INS  dt 0.000s  fwd +0.000 m/s&#178;  vel 0.000 to 0.000 m/s" android:textColor="#475569" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- RECORDING -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RECORDING" android:textColor="#334155" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.15" android:layout_marginBottom="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_bg" android:padding="12dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/tvDbgTripStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="&#9679; IDLE" android:textColor="#64748B" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvDbgSampleCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 logged" android:textColor="#475569" android:textSize="11sp" android:fontFamily="monospace" />
                </LinearLayout>
                <Button android:id="@+id/btnDebugRecord" android:layout_width="match_parent" android:layout_height="48dp" android:text="&#9679; Start Recording" android:textColor="#FFFFFF" android:textStyle="bold" android:backgroundTint="#B91C1C" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnDebugCalibrate" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Calibrate Frame" android:textColor="#94A3B8" android:textSize="11sp" android:backgroundTint="#1E2535" android:layout_marginEnd="6dp" />
                    <Button android:id="@+id/btnDebugShare" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Export CSV" android:textColor="#94A3B8" android:textSize="11sp" android:backgroundTint="#1E2535" android:enabled="false" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
