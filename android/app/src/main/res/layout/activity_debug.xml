<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface_primary"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnDebugBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer Mode"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engineering Telemetry &amp; Diagnostics"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDebugRecIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● IDLE"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. PIPELINE ARCHITECTURE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. PIPELINE ARCHITECTURE &amp; SUBSYSTEM HEALTH"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgPipelineDiagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMU (200Hz) → VEHICLE FRAME → 10Hz CANONICAL → TCN BUFFER → ESKF\nGNSS FIX → 1D ADAPTIVE KF → NIS GATING → ESKF 15-STATE FUSION"
                    android:textColor="@color/nav_success"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDbgHealthSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMU Stream: ACTIVE (200 Hz) · GNSS Fix: ACTIVE"
                    android:textColor="@color/nav_success"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgHealthDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accel · Gyro · RotVec · Gravity · Mag · GNSS -- all ACTIVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 2. GNSS DEFICIT & NAVIGATION MODE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. SEAMLESS GNSS DEFICIT &amp; NAVIGATION MODE"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Nav Mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgNavMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NAVIGATING"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Estimator"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgDrProvider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PERCORSA_ESKF (15-State)"
                        android:textColor="@color/nav_warning"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Deficit State"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgGnssQuality"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GNSS AVAILABLE · DR Standby"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="Pos Accuracy"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgAccuracy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="± 4.5 m (GNSS Doppler)"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

            </LinearLayout>

            <!-- 3. AI-ASSISTED FUSION & SPEED ESTIMATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. AI SPEED ESTIMATE &amp; FUSION VISIBILITY"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgTcnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TCN Buffer: 50/50 READY (5.0s @ 10 Hz canonical stream)"
                    android:textColor="@color/nav_success"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgTcnModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model: ACTIVE · Raw: 12.40 m/s · Filtered: 12.35 m/s (44.5 km/h)"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgTcnMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inference: 4.8 ms · Fix Age: 95 ms · Rejections: 0"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgProcessedStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10Hz Canonical: ax=+0.12 ay=-0.04 az=+9.81 gx=+0.01 gy=0.00 gz=-0.02"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 4. 15-STATE ESKF ESTIMATOR & MEASUREMENT UPDATES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. 15-STATE ESKF ESTIMATOR &amp; UPDATES"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgEskfState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="State: READY · Calibrated: YES · Pos: 12.97159, 77.59456"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgEskfVectors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vel ENU: (+8.50, +9.10, -0.05) · Speed: 12.45 m/s · Hdg: 43.1° · dt: 0.005s"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgEskfCov"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cov Trace: 1.42 · Quat Norm: 1.000000 · Status: HEALTHY"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgEskfUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GNSS: ACC (NIS 1.25, Innov 0.8m) · TCN: ACC (NIS 0.62)\nNHC: acc=true (NIS 0.31) · ZUPT: acc=false (NIS --)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 5. IN-VEHICLE ALIGNMENT & CALIBRATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. IN-VEHICLE ALIGNMENT &amp; ARBITRARY MOUNTING"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Mounting"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgOrient"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="P +12° R -4° Y +185° · RV (Arbitrary Mount)"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Veh Accel"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgVehicleFrameAccel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fwd +0.450 Left -0.020 Up +9.810 m/s²"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Veh Gyro"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgVehicleFrameGyro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fwd +0.001 Left +0.000 Up -0.024 rad/s"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="Frame Status"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgFilterStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CALIBRATED · Gravity + Acceleration Aligned"
                        android:textColor="@color/nav_success"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 6. MAP MATCHING & VEHICLE CONSTRAINTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. MAP MATCHING &amp; VEHICLE CONSTRAINTS"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgRouteTracking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Map Match: ACTIVE (Seg #3, Progress: 412.5m)\nCross-Track: 1.2m · Hdg Error: 2.1° · Turn: STRAIGHT (0.2°/s)"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.2" />

            </LinearLayout>

            <!-- 7. GNSS TELEMETRY & 1D KALMAN FILTER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. GNSS TELEMETRY &amp; 1D ADAPTIVE KF"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● GPS GOOD (Fix age: 140 ms)"
                    android:textColor="@color/nav_success"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDbgGpsQualityReason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality: GOOD (Accuracy 4.2m, Provider GPS)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvDbgGpsCoords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Raw Lat: 12.97160  Lon: 77.59458\nESKF Lat: 12.97159  Lon: 77.59456"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDbgGpsAccuracy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accuracy: 4.2 m"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvDbgGpsSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Doppler Speed: 44.8 km/h"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

            </LinearLayout>

            <!-- 8. SENSOR TIMING & PIPELINE RATES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. REAL-TIME PIPELINE TIMING &amp; RATES"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgImuHz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IMU Rate: 198.4 Hz (Callbacks: 198.4 Hz) · 10 Hz Canonical"
                    android:textColor="@color/nav_success"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgTimingStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="dt avg 5.04 ms · min 4.82 · max 5.29 · jitter 0.22 ms"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 9. RAW SENSOR READINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9. RAW SENSOR READINGS (PHONE FRAME)"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDbgAccel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accel: X +0.120 Y -0.450 Z +9.780 m/s² (Mag: 9.79)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvDbgGyro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gyro:  X +0.002 Y -0.001 Z -0.024 rad/s (Mag: 0.02)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvDbgQuat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quat:  W 0.985 X 0.042 Y -0.015 Z 0.168 (Norm: 1.000 • VALID)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvDbgMag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mag:   X +18.2 Y -24.1 Z -36.5 µT (Mag: 47.3 µT)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvDbgGravity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grav:  X +0.10 Y -0.42 Z +9.80 m/s² (Mag: 9.81 • NORMAL)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvDbgLinearAccel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linear: X +0.02 Y -0.03 Z -0.02 m/s² (Mag: 0.04)"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- 10. DATA LOGGING & CALIBRATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10. DATA LOGGING &amp; CALIBRATION"
                android:textColor="@color/percorsa_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="@dimen/card_padding_sm"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvDbgTripStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● IDLE"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDbgSampleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 samples logged"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnDebugRecord"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="● Start Sensor Logging (CSV)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:backgroundTint="#B91C1C"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDebugCalibrate"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Calibrate Vehicle Frame"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        android:background="@drawable/btn_secondary_bg"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDebugShare"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Export CSV"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        android:background="@drawable/btn_secondary_bg"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
