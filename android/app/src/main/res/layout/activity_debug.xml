<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F1A">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#12171F"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnDebugBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="22sp"
            android:textColor="#38BDF8"
            android:gravity="center"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer Mode"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics &amp; Health Monitoring"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Recording indicator -->
        <TextView
            android:id="@+id/tvDebugRecIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● IDLE"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── NAVIGATION HEALTH SECTION ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM HEALTH"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDbgHealthSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS: GOOD | IMU: GOOD | Filter: GOOD"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgHealthDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMU: 200Hz | GPS Acc: 5.0m"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ── GPS Section ──────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GNSS"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDbgGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● ACQUIRING"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgGpsCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lat: -- Lon: --"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDbgGpsAccuracy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Accuracy: -- m"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDbgGpsSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Speed: -- km/h"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── IMU Section ──────────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INERTIAL SENSORS"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvDbgImuHz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="IMU: 0 Hz"
                        android:textColor="#34D399"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDbgSamples"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Samples: 0"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCEL m/s²"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDbgAccel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X: +0.00  Y: +0.00  Z: -9.81"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GYRO rad/s"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDbgGyro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X: +0.00  Y: +0.00  Z: +0.00"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ORIENTATION (P/R/Y)"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDbgOrient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P: +0°  R: +0°  Y: +0°"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VEHICLE FRAME ACCEL (Fwd/Left/Up)"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDbgVehicleFrameAccel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fwd: +0.00  Left: +0.00  Up: -9.81"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- ── TCN & ML PIPELINE SECTION ──────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TCN ML PIPELINE (10 Hz Canonical)"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDbgTcnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TCN Input Buffer: 0/20 WAITING (10 Hz canonical stream)"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgTcnModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: NOT ACTIVE (Ready for downstream inference on feature/ml-speed-tcn)"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgProcessedStream"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pipeline: RAW → GRAVITY → LINEAR → VEHICLE FRAME → 10 Hz CANONICAL"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- ── Navigation Engine Section ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATION ENGINE"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvDbgNavMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode: IDLE"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgDrProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DR Provider: NONE"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgGnssQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GNSS Quality: DENIED"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDbgAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Position Accuracy: -- m"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- ── Recording Section ──────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR RECORDING"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvDbgTripStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="● IDLE"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDbgSampleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 logged"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnDebugRecord"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="● Start Recording"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#DC2626"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDebugCalibrate"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Calibrate Frame"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:backgroundTint="#1E293B"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDebugShare"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Export CSV"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:backgroundTint="#0284C7"
                        android:enabled="false" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
