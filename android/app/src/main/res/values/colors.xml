<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Legacy Android defaults -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ── Percorsa Premium Dark Theme ───────────────────────────────────── -->
    <!-- Dark, clean surfaces inspired by modern navigation apps -->
    <color name="surface_background">#0B0D10</color>
    <color name="surface_primary">#171A1F</color>
    <color name="surface_secondary">#1D2126</color>

    <!-- ── Brand & Accent ─────────────────────────────────────────────────── -->
    <!-- Primary accent: restrained teal for navigation -->
    <color name="percorsa_primary_light">#2DD4BF</color>
    <color name="percorsa_accent">#38BDF8</color>

    <!-- ── GNSS Signal States ─────────────────────────────────────────────── -->
    <!-- GOOD: confident green -->
    <color name="gnss_good_bg">#12372F</color>

    <!-- DEGRADED/FAIR: caution amber -->
    <color name="gnss_fair_bg">#3B2A0B</color>
    <color name="gnss_poor_bg">#3B2A0B</color>

    <!-- LOST/DENIED: alert orange -->
    <color name="gnss_denied_bg">#3D1E10</color>

    <!-- RECOVERING: cool status tone -->
    <color name="gnss_recovering_bg">#0C3143</color>

    <!-- ── Navigation States ──────────────────────────────────────────────── -->
    <color name="nav_success">#10B981</color>
    <color name="nav_warning">#F59E0B</color>
    <color name="nav_error">#EF4444</color>
    <color name="nav_info">#3B82F6</color>

    <!-- ── ML Status ────────────────────────────────────────────────────── -->
    <color name="ml_error">#EF4444</color>

    <!-- ── Text Colors ───────────────────────────────────────────────────── -->
    <!-- Primary: dark for readability -->
    <color name="text_inverse">#FFFFFF</color>

    <!-- ── Dividers & Borders ───────────────────────────────────────────── -->
    <color name="border">#4A515B</color>
    <color name="border_subtle">#343A42</color>

    <!-- ── Shadows ──────────────────────────────────────────────────────── -->
    <color name="shadow_light">#1A000000</color>
    <color name="shadow_medium">#33000000</color>
    <color name="shadow_dark">#66000000</color>

    <!-- ── Legacy dark theme (for debug mode) ────────────────────────────── -->
    <color name="surface_deepest">#0B1220</color>
    <color name="surface_deep">#0F1626</color>
    <color name="surface_card">#D9141B2E</color>        <!-- #141B2E at 85% opacity -->
    <color name="surface_elevated">#E6182238</color>    <!-- elevated panel -->
    <color name="surface_overlay">#F20B1220</color>

    <!-- ── Brand & Signal States ────────────────────────────────────────── -->
    <!-- GNSS-Locked state (signal trusted): electric cyan #3DD6F5 -->
    <color name="percorsa_primary">#3DD6F5</color>
    <color name="percorsa_primary_dark">#0284C7</color>
    <color name="percorsa_primary_deep">#0369A1</color>
    <color name="gnss_good">#3DD6F5</color>
    <color name="gnss_fair">#38BDF8</color>

    <!-- Inertial / dead-reckoning state (signal lost): signal amber #FFB020 -->
    <color name="gnss_poor">#FFB020</color>
    <color name="gnss_denied">#FFB020</color>
    <color name="gnss_recovering">#A78BFA</color>
    <color name="nav_amber">#FFB020</color>

    <!-- Critical / Error state: coral red #FF5C5C -->
    <color name="nav_red">#FF5C5C</color>
    <color name="nav_green">#3DD6F5</color>
    <color name="nav_purple">#A78BFA</color>
    <color name="nav_blue">#3DD6F5</color>
    <color name="ml_active">#22C55E</color>
    <color name="ml_ready">#F59E0B</color>

