    <!-- Primary text: off-white #EDF1F7, secondary text: slate #8A93A6 -->
    <color name="text_primary">#EDF1F7</color>
    <color name="text_secondary">#8A93A6</color>
    <color name="text_tertiary">#5A6478</color>
    <color name="text_hint">#424B5D</color>

