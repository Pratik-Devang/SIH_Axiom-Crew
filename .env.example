# Generate a long random value. Never commit the real key.
PERCORSA_API_KEY=replace-with-at-least-32-random-characters

# Add the laptop LAN IP when the Android app is ready to connect.
PERCORSA_API_HOST=127.0.0.1
PERCORSA_API_PORT=8000
PERCORSA_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
PERCORSA_ALLOWED_ORIGINS=
