# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local data — raw and processed datasets are not committed
data/raw/**
data/interim/**
data/processed/**
data/external/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# artifacts/ is intentionally committed so the team can access the trained TCN
# and ONNX model without retraining.  Do NOT add blanket ignores for artifacts/.

# Results and demo recordings
results/metrics/**
results/plots/**
results/trajectories/**
demo/recordings/**
!results/metrics/.gitkeep
!results/plots/.gitkeep
!results/trajectories/.gitkeep
!demo/recordings/.gitkeep

# Android local and generated files
android/.gradle/
android/.kotlin/
android/.idea/
android/local.properties
android/**/build/

# Accidental root-level Android outputs
.gradle/
.kotlin/
build/
app/build/
local.properties

# Generated runtime caches and event logs
cache/
logs/
